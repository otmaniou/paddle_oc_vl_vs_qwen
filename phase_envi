import finegrained_fp8
import inspect

print("=== SOURCE / SIGNATURES UTILES ===")

for name in dir(finegrained_fp8):
    if "quant" in name.lower():
        obj = getattr(finegrained_fp8, name)

        print("\nFUNCTION :", name)

        try:
            print("SIGNATURE:", inspect.signature(obj))
        except Exception as e:
            print("Signature indisponible:", e)

        try:
            print(inspect.getsource(obj)[:4000])
        except Exception:
            pass
