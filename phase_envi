import torch
import finegrained_fp8
import time

print("=== TEST GPU FINEGRAINED FP8 ===")

print("Torch :", torch.__version__)
print("CUDA  :", torch.version.cuda)
print("GPU   :", torch.cuda.get_device_name(0))

# Tensor BF16 sur GPU
x = torch.randn(
    (256, 256),
    device="cuda",
    dtype=torch.bfloat16
)

torch.cuda.synchronize()

t0 = time.perf_counter()

try:
    x_fp8, scale = finegrained_fp8.fp8_act_quant(
        x,
        block_size=128
    )

    torch.cuda.synchronize()
    elapsed = (time.perf_counter() - t0) * 1000

    print("\nTEST : OK")
    print("Input shape :", x.shape)
    print("Input dtype :", x.dtype)

    print("\nFP8 shape   :", x_fp8.shape)
    print("FP8 dtype   :", x_fp8.dtype)

    print("\nScale shape :", scale.shape)
    print("Scale dtype :", scale.dtype)

    print("\nDevice FP8  :", x_fp8.device)
    print("Temps       :", round(elapsed, 3), "ms")

except Exception as e:
    print("\nTEST : ERREUR")
    print(type(e).__name__, ":", e)
    raise
